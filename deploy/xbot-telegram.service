[Unit]
Description=X Content Agent Telegram Bot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=sachit
WorkingDirectory=/home/sachit/XBot
ExecStart=/home/sachit/XBot/venv/bin/python telegram_bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
